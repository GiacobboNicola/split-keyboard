#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        hkp: hkp {
            compatible = "zmk,behavior-hold-tap";
            label = "HKP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <17 18 19 16 23 22 24 25 15>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&trans  &kp Q            &kp W            &kp E         &kp R              &kp T      &bt BT_SEL 0          &bt BT_SEL 1     &kp Y        &kp U               &kp I         &kp O             &kp P          &trans
&trans  &hkp LEFT_GUI A  &hkp LEFT_ALT S  &hkp LCTRL D  &hkp LEFT_SHIFT F  &kp G      &kp C_AL_SCREENSAVER  &kp PRINTSCREEN  &kp H        &hkp RIGHT_SHIFT J  &hkp RCTRL K  &hkp RIGHT_ALT L  &kp SEMICOLON  &trans
&trans  &kp Z            &kp X            &kp C         &kp V              &kp B                                             &kp N        &kp M               &kp COMMA     &kp DOT           &kp FSLH       &trans
                                          &kp ESCAPE    &lt 1 SPACE        &lt 2 TAB                                         &lt 5 ENTER  &lt 4 BACKSPACE     &lt 6 DELETE
            >;
        };

        layer_1 {
            display-name = "ARROWS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  | LCTRL | RCTRL |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |  LALT | RALT  |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |               | ENT |     | ALT |

            bindings = <
&trans  &kp C_RESET   &none          &none             &none           &none  &none  &none  &kp K_AGAIN  &kp K_UNDO      &kp ASTRK      &kp LPAR      &kp RPAR         &trans
&trans  &kp LEFT_GUI  &kt LEFT_ALT   &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none  &none  &kp CAPS     &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &none         &kp RIGHT_ALT  &none             &none           &none                &kp INSERT   &kp C_AC_HOME   &kp PAGE_DOWN  &kp PAGE_UP   &kp END          &trans
                                     &none             &trans          &none                &kp RET      &kp BACKSPACE   &kp DELETE
            >;
        };

        layer_2 {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                        &trans  &trans  &trans                  &mkp MB1  &mkp MB3        &mkp MB2
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        layer_4 {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5    |  LCTRL | RCTRL |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | CTRL | BT1 | BT2 | BT3 | BT4 | BT5   |  LALT  | RALT  | LFT | DWN |  UP | RGT |     |      |
            // | SHFT | BTCR| RGB | RST | BOOT| Unlock|        |       |     |     |     |     |     |      |
            //                    | GUI |     | SPC   |        | ENT   |     | ALT |

            bindings = <
&trans  &kp RS(LEFT_BRACKET)  &kp RS(N7)        &kp RS(N8)        &kp RS(N9)        &kp RS(RIGHT_BRACKET)     &bt BT_CLR_ALL   &none  &none      &none            &none              &none          &kp C_RESET    &trans
&trans  &kp RS(SQT)           &kp RS(NUMBER_4)  &kp RS(N5)        &kp RS(NUMBER_6)  &kp RS(EQUAL)             &rgb_ug RGB_TOG  &none  &none      &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp LEFT_ALT   &kp RIGHT_GUI  &trans
&trans  &kp RS(GRAVE)         &kp RS(NUMBER_1)  &kp RS(NUMBER_2)  &kp RS(NUMBER_3)  &kp RS(NON_US_BACKSLASH)                          &none      &none            &none              &kp RIGHT_ALT  &none          &trans
                                                &kp RS(PERIOD)    &kp RS(N0)        &kp RS(MINUS)                                     &kp ENTER  &kp BACKSPACE    &kp DELETE
            >;
        };

        layer_5 {
            display-name = "SYMBOLS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        layer_6 {
            display-name = "FNKEYS";
            bindings = <
&trans  &kp F12  &kp F7  &kp F8        &kp F9     &kp PRINTSCREEN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &kp F4  &kp F5        &kp F6     &kp SCROLLLOCK   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F1  &kp F2        &kp F3     &kp C_PAUSE                      &trans  &trans  &trans  &trans  &trans  &trans
                         &kp LEFT_GUI  &kp SPACE  &kp TAB                          &trans  &trans  &trans
            >;
        };

        extra_layer_5 {
            display-name = "EXTRA 5";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
